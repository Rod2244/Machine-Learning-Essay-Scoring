# Kaggle API Credentials
# Get these from https://www.kaggle.com/settings/account
# Download your kaggle.json file and use the username and key from there

KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Flask Config
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Dataset IDs (from Kaggle)
DATASET_1=c/competitions/asap-aes/data
DATASET_2=c/competitions/learning-agency-lab-automated-essay-scoring-2/data
